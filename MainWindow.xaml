<Window x:Class="MazEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mazatrol Nexus 2 Editor" Height="500" Width="900" Background="#1E1E1E">

    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#222222"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Blue"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Background="#2D2D30" Grid.Row="0">
            <Button Content="OPEN .MAZ" Click="OpenBtn_Click" Margin="10" Width="100" Height="35" FontWeight="Bold" Cursor="Hand"/>
            <Button Content="SAVE CHANGES" IsEnabled="False" Margin="5" Width="120" Height="35" FontWeight="Bold"
                    ToolTip="Save is not implemented yet."/>
            <TextBlock x:Name="ProgHeader" Foreground="Lime" VerticalAlignment="Center" Margin="20,0" FontSize="18" FontWeight="Bold" FontFamily="Consolas" Text="SELECT A FILE..."/>
        </StackPanel>

        <DataGrid x:Name="MazGrid" Grid.Row="1" Background="Black" Foreground="Yellow"
                  RowBackground="Black" AlternatingRowBackground="#121212"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#333" VerticalGridLinesBrush="#333"
                  BorderThickness="0" FontSize="14" FontFamily="Consolas">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SEQ" Binding="{Binding SequenceNo}" Width="40" IsReadOnly="True"/>
                <DataGridTextColumn Header="TYPE" Binding="{Binding TypeName}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="X COORD" Binding="{Binding X_Coord}" Width="90"/>
                <DataGridTextColumn Header="Y COORD" Binding="{Binding Y_Coord}" Width="90" Foreground="Yellow"/>
                <DataGridTextColumn Header="Z COORD" Binding="{Binding Z_Coord}" Width="90"/>
                <DataGridTextColumn Header="DEPTH / ANGLE" Binding="{Binding Parameter}" Width="110"/>
                <DataGridTextColumn Header="NAME / COMMAND" Binding="{Binding GCodeLine}" Width="*" Foreground="Cyan"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="2" Background="#2D2D30">
            <TextBlock x:Name="StatusTxt" Foreground="LightGray" FontSize="12" Margin="10,0" Text="Ready"/>
        </StatusBar>
    </Grid>
</Window>
