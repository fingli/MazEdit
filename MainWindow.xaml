<Window x:Class="MazEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MazEdit"
        Title="Mazatrol Nexus 2 Editor" Height="720" Width="1400" MinWidth="1100" MinHeight="520" Background="#1E1E1E">

    <Window.Resources>
        <local:SummaryPartsConverter x:Key="SummaryPartsConverter"/>

        <SolidColorBrush x:Key="FieldNameBrush" Color="#7FDBFF"/>
        <SolidColorBrush x:Key="FieldValueBrush" Color="White"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#222222"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#003366"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueTextColumn" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FieldValueBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="NameTextColumn" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FieldNameBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Background="#2D2D30" Grid.Row="0">
            <Button Content="OPEN .MAZ" Click="OpenBtn_Click" Margin="10" Width="100" Height="35" FontWeight="Bold" Cursor="Hand"/>
            <Button x:Name="ExportDumpBtn" Content="EXPORT DUMP" Click="ExportDumpBtn_Click" IsEnabled="False" Margin="5" Width="110" Height="35" FontWeight="Bold" Cursor="Hand"
                    ToolTip="Save a text report (safe to share) instead of the binary .maz file."/>
            <Button Content="SAVE CHANGES" IsEnabled="False" Margin="5" Width="120" Height="35" FontWeight="Bold"
                    ToolTip="Save is not implemented yet."/>
            <TextBlock x:Name="ProgHeader" Foreground="Lime" VerticalAlignment="Center" Margin="20,0" FontSize="18" FontWeight="Bold" FontFamily="Consolas" Text="SELECT A FILE..."/>
        </StackPanel>

        <DataGrid x:Name="MazGrid" Grid.Row="1" Background="Black" Foreground="White"
                  RowBackground="Black" AlternatingRowBackground="#121212"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  RowHeight="44" FontSize="16"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#333" VerticalGridLinesBrush="#333"
                  BorderThickness="0" FontFamily="Consolas"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="UNo" Binding="{Binding UnitNo}" Width="56" IsReadOnly="True"
                                    ElementStyle="{StaticResource ValueTextColumn}"/>
                <DataGridTextColumn Header="SNo" Binding="{Binding SequenceNo}" Width="56" IsReadOnly="True"
                                    ElementStyle="{StaticResource ValueTextColumn}"/>
                <DataGridTextColumn Header="TYPE" Binding="{Binding TypeName}" Width="120" IsReadOnly="True"
                                    ElementStyle="{StaticResource NameTextColumn}"/>
                <DataGridTemplateColumn Header="SUMMARY" Width="*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Summary, Converter={StaticResource SummaryPartsConverter}}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource FieldNameBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Value}" Foreground="{StaticResource FieldValueBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="2" Background="#2D2D30">
            <TextBlock x:Name="StatusTxt" Foreground="LightGray" FontSize="12" Margin="10,0" Text="Ready"/>
        </StatusBar>
    </Grid>
</Window>
