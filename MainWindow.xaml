<Window x:Class="MazEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mazatrol Nexus 2 - Hierarchical Editor" Height="600" Width="1000" Background="#1E1E1E">

    <Window.Resources>
        <!-- CNC Style Header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#222"/>
        </Style>

        <!-- CNC Style Cell Selection -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Top Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Main Grid -->
            <RowDefinition Height="30"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOOLBAR -->
        <StackPanel Orientation="Horizontal" Background="#2D2D30" Grid.Row="0">
            <Button Content="OPEN .MAZ" Click="OpenBtn_Click" Margin="10" Width="100" Height="35" Cursor="Hand" Background="#FF3C3C3C" Foreground="White" BorderBrush="#FF5F5F5F"/>
            <Button Content="SAVE CHANGES" Click="SaveBtn_Click" Margin="5" Width="120" Height="35" Background="#FF004D00" Foreground="White" FontWeight="Bold" Cursor="Hand"/>

            <Separator Width="2" Margin="15,10" Background="#444"/>

            <TextBlock x:Name="ProgHeader" Foreground="Lime" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" FontFamily="Consolas" Text="READY TO LOAD"/>
        </StackPanel>

        <!-- 2. HIERARCHICAL DATAGRID -->
        <DataGrid x:Name="MazGrid" Grid.Row="1" 
                  Background="Black" Foreground="Yellow" 
                  RowBackground="Black" AlternatingRowBackground="#111"
                  AutoGenerateColumns="False" CanUserAddRows="False" 
                  SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333"
                  FontSize="14" FontFamily="Consolas" BorderThickness="0"
                  RowDetailsVisibilityMode="VisibleWhenSelected">

            <DataGrid.Columns>
                <!-- Main Columns -->
                <DataGridTextColumn Header="SEQ" Binding="{Binding SequenceNo}" Width="50" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="UNIT TYPE" Binding="{Binding TypeName}" Width="150" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Lime"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="X / NOM-Ø" Binding="{Binding X}" Width="110"/>
                <DataGridTextColumn Header="Y / DEPTH" Binding="{Binding Y}" Width="110"/>
                <DataGridTextColumn Header="Z / SRV-Z" Binding="{Binding Z}" Width="110"/>
                <DataGridTextColumn Header="PARAMETER" Binding="{Binding Param}" Width="110"/>

                <DataGridTextColumn Header="SUB-CALL / NAME" Binding="{Binding Name}" Width="*" Foreground="Cyan"/>
            </DataGrid.Columns>

            <!-- 3. HIERARCHY DETAILS (Shows when you click a unit) -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="#1A1A1A" Padding="15" BorderBrush="Lime" BorderThickness="2,0,0,0" Margin="40,5,5,5">
                        <StackPanel>
                            <TextBlock Text="↳ UNIT COMPONENT DETAILS (TOOLING &amp; GEOMETRY)" 
                                       Foreground="#888" FontSize="11" Margin="0,0,0,10" FontWeight="Bold"/>

                            <!-- Nested items for children -->
                            <ItemsControl ItemsSource="{Binding Children}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <!-- Type -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- X -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- Y -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- Z -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Name -->
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding TypeName}" Foreground="Lime" Grid.Column="0" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding X}" Foreground="White" Grid.Column="1"/>
                                            <TextBlock Text="{Binding Y}" Foreground="White" Grid.Column="2"/>
                                            <TextBlock Text="{Binding Z}" Foreground="White" Grid.Column="3"/>
                                            <TextBlock Text="{Binding Name}" Foreground="Cyan" Grid.Column="4" FontStyle="Italic"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- 4. STATUS BAR -->
        <StatusBar Grid.Row="2" Background="#2D2D30">
            <StatusBarItem>
                <TextBlock x:Name="StatusTxt" Foreground="DarkGray" FontSize="12" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>