<Window x:Class="MazEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mazatrol Nexus 2 Editor" Height="500" Width="900" Background="#1E1E1E">

    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#222222"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Blue"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Background="#2D2D30" Grid.Row="0">
            <Button Content="OPEN .MAZ" Click="OpenBtn_Click" Margin="10" Width="100" Height="35" FontWeight="Bold" Cursor="Hand"/>
            <Button Content="SAVE CHANGES" IsEnabled="False" Margin="5" Width="120" Height="35" FontWeight="Bold"
                    ToolTip="Save is not implemented yet."/>
            <TextBlock x:Name="ProgHeader" Foreground="Lime" VerticalAlignment="Center" Margin="20,0" FontSize="18" FontWeight="Bold" FontFamily="Consolas" Text="SELECT A FILE..."/>
        </StackPanel>

        <DataGrid x:Name="MazGrid" Grid.Row="1" Background="Black" Foreground="Yellow" 
          AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
          RowBackground="Black" AlternatingRowBackground="#111" GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <DataGridTextColumn Header="SEQ" Binding="{Binding SequenceNo}" Width="40" IsReadOnly="True"/>
                <DataGridTextColumn Header="UNIT TYPE" Binding="{Binding TypeName}" Width="150" Foreground="Lime"/>
                <DataGridTextColumn Header="X / NOM-Ø" Binding="{Binding X}" Width="100"/>
                <DataGridTextColumn Header="Y / DEPTH" Binding="{Binding Y}" Width="100"/>
                <DataGridTextColumn Header="Z / SRV-Z" Binding="{Binding Z}" Width="100"/>
                <DataGridTextColumn Header="SUB-CALL / NAME" Binding="{Binding Name}" Width="*" Foreground="Cyan"/>
            </DataGrid.Columns>

            <!-- HIERARCHY: Show children when row is selected -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <StackPanel Background="#1A1A1A" Margin="40,0,0,0">
                        <TextBlock Text="↳ UNIT DETAILS (TOOLS/SHAPES):" Foreground="Gray" FontSize="10" Margin="5"/>
                        <ItemsControl ItemsSource="{Binding Children}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TypeName}" Foreground="Lime" Grid.Column="0"/>
                                        <TextBlock Text="{Binding X}" Foreground="White" Grid.Column="1"/>
                                        <TextBlock Text="{Binding Y}" Foreground="White" Grid.Column="2"/>
                                        <TextBlock Text="{Binding Z}" Foreground="White" Grid.Column="3"/>
                                        <TextBlock Text="{Binding Name}" Foreground="Cyan" Grid.Column="4"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
        <StatusBar Grid.Row="2" Background="#2D2D30">
            <TextBlock x:Name="StatusTxt" Foreground="LightGray" FontSize="12" Margin="10,0" Text="Ready"/>
        </StatusBar>
    </Grid>
</Window>
